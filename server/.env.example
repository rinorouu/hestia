# Hestia server configuration — salin ke .env lalu sesuaikan.
# JANGAN commit .env asli (lihat SECURITY.md).

# Port HTTP server
PORT=3000

# Path mount HDD eksternal (root Storage). Semua file user disimpan di sini.
# Contoh produksi: /mnt/hestia
STORAGE_MOUNT_PATH=/mnt/hestia

# Wajib true di produksi: menolak operasi bila STORAGE_MOUNT_PATH bukan mount point
# (mencegah menulis ke disk sistem saat HDD belum terpasang).
# Set false untuk development lokal tanpa HDD.
REQUIRE_MOUNT=false

# Lokasi file database SQLite (metadata).
# Default dev: ./data/hestia.db (di server).
# Produksi disarankan: <STORAGE_MOUNT_PATH>/System/hestia.db (ikut ter-backup bersama HDD).
DB_PATH=./data/hestia.db

# Secret untuk JWT. Ganti dengan string acak panjang.
# Hasilkan mis. dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Masa berlaku token (mis. 30d, 7d, 12h). Default 30 hari.
JWT_EXPIRES_IN=30d

# Batas ukuran upload per file dalam byte (dipakai pada Tahap 3). Default 2 GB.
MAX_UPLOAD_SIZE=2147483648
